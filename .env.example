# GEMINI_API_KEY2: Optional user-provided Gemini API key prioritized over system GEMINI_API_KEY.
GEMINI_API_KEY2="MY_GEMINI_API_KEY2"

# GEMINI_API_KEY: System-managed Gemini API key fallback.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Optional fallback provider #3 (OpenRouter - deepseek/deepseek-r1:free).
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# NVIDIA_API_KEY: Optional fallback provider #4 (NVIDIA NIM - deepseek-ai/deepseek-r1).
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# GROQ_API_KEY: Optional fallback provider #5 (Groq - llama-3.3-70b-versatile).
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
