# GEMINI_API_KEY2: Optional user-provided Gemini API key prioritized over system GEMINI_API_KEY.
GEMINI_API_KEY2="MY_GEMINI_API_KEY2"

# GEMINI_API_KEY: System-managed Gemini API key fallback.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Optional fallback provider #2 (OpenRouter).
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# NVIDIA_API_KEY: Optional fallback provider #3 (NVIDIA NIM).
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# Optional model overrides per provider (defaults configured in server/providerCascade.ts):
# - Google Gemini primary: "gemini-3.8-flash" (internal fallbacks: "gemini-3.1-flash-lite", "gemini-flash-latest")
# - OpenRouter primary: "openrouter/free"
# - NVIDIA NIM primary: "nvidia/nemotron-3.5-lightning-30b-a3b" (secondary fallback: "mistralai/mistral-large-2-instruct")
# GEMINI_MODEL="gemini-3.8-flash"
# OPENROUTER_MODEL="openrouter/free"
# NVIDIA_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"

# Optional timeout budgets in milliseconds (defaults configured in server/providerCascade.ts):
# GEMINI_TIMEOUT_MS="45000"
# OPENROUTER_TIMEOUT_MS="38000"
# NVIDIA_TIMEOUT_MS="38000"
# CASCADE_TOTAL_BUDGET_MS="95000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
