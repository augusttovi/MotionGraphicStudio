# GEMINI_API_KEY2: Optional user-provided Gemini API key prioritized over system GEMINI_API_KEY.
GEMINI_API_KEY2="MY_GEMINI_API_KEY2"

# GEMINI_API_KEY: System-managed Gemini API key fallback.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Optional fallback provider #2 (OpenRouter - openrouter/free with reasoning disabled).
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# NVIDIA_API_KEY: Optional fallback provider #3 (NVIDIA NIM - nvidia/nemotron-3.5-lightning-30b-a3b with fallback to mistralai/mistral-large-2-instruct).
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# Optional verified model overrides per provider:
GEMINI_MODEL="gemini-3.8-flash"
OPENROUTER_MODEL="openrouter/free"
NVIDIA_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"

# Optional per-provider timeout budgets in milliseconds:
GEMINI_TIMEOUT_MS="75000"
OPENROUTER_TIMEOUT_MS="60000"
NVIDIA_TIMEOUT_MS="60000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
